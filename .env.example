# Local secrets for maintainer tooling. Copy to `.env` (which is gitignored) and
# fill in real values. NEVER commit the real `.env`.

# Discord webhook URL for the announcements channel, used by scripts/announce.sh.
# Create it in Discord: Channel Settings → Integrations → Webhooks → New Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxx/yyyyyyyyyyyy
